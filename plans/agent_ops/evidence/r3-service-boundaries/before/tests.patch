+def wait_until(predicate, timeout=30):
+    deadline = time.monotonic() + timeout
+    while True:
+        answer = predicate()
+        if answer:
+            return answer
+        assert time.monotonic() < deadline, (
+            "Disposable owner did not reach the expected boundary"
+        )
+        time.sleep(0.05)
+
