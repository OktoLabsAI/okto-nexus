+def isolated_env(root):
+    # No inherited secret/proxy/provider/Nexus/Core configuration values.
+    env = {
+        k: v
+        for k, v in os.environ.items()
+        if k.upper() in {"SYSTEMROOT", "WINDIR", "COMSPEC"}
+    }
+    # os.environ on Windows is case-insensitive; our plain isolated dictionary
+    # must retain the canonical spelling consumed by the production allowlist.
+    env["SystemRoot"] = os.environ["SYSTEMROOT"]
+    for key, folder in [
+        ("TEMP", "temp"),
+        ("TMP", "temp"),
+        ("USERPROFILE", "profile"),
+        ("APPDATA", "appdata"),
+        ("LOCALAPPDATA", "localappdata"),
+    ]:
+        path = root / folder
+        path.mkdir(parents=True, exist_ok=True)
+        env[key] = str(path)
+    env.update(PYTHONUTF8="1", PYTHONDONTWRITEBYTECODE="1", OKTO_NEXUS_NO_BANNER="1")
+    env["PATH"] = (
+        str(Path(sys.executable).parent)
+        + os.pathsep
+        + str(Path(env["SYSTEMROOT"]) / "System32")
+    )
+    return env
+
