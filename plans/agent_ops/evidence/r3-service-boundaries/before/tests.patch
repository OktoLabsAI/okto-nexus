+def test_occupied_port_refuses_without_fallback_and_exposes_the_bind_cause(
+    tmp_path, monkeypatch, capsys
+):
+    """Real occupied socket; observe public service result and bounded logs."""
+    from okto_nexus.adapters.outbound.service_manager import local
+
+    real_popen = subprocess.Popen
+    children = []
+    private = tmp_path / "child-stderr.txt"
+    with bound_port() as (listener, port), private.open("wb") as log:
+        args = selection(tmp_path, port)
+
+        def capture(*a, **kw):
+            # Only retain the real spawn's output; argv, environment and effects
+            # are unchanged. Captured raw stderr is diagnostic, not public UX.
+            kw["stderr"] = log
+            child = real_popen(*a, **kw)
+            children.append(child)
+            return child
+
+        monkeypatch.setattr(local.subprocess, "Popen", capture)
+        with monkeypatch.context() as envpatch:
+            envpatch.setattr(os, "environ", isolated_env(tmp_path))
+            code = service.run_service(["start", *args, "--json", "--timeout", "20"])
+        report = json.loads(capsys.readouterr().out)
+        for child in children:
+            child.wait(timeout=30)
+        log.flush()
+        assert len(children) == 1
+        assert children[0].returncode != 0
+        assert code != 0 and report["state"] != "ready"
+        assert listener.getsockname() == ("127.0.0.1", port)
+        context = read_json(tmp_path / "home/service-context.json")
+        assert context["arguments"][context["arguments"].index("--port") + 1] == str(
+            port
+        )
+        assert context["arguments"][context["arguments"].index("--db-path") + 1] == str(
+            tmp_path / "data/selected.sqlite"
+        )
+        assert not (tmp_path / "home/nexus.db").exists()
+        with ServeLock(tmp_path / "home", db_path=tmp_path / "data/selected.sqlite"):
+            pass
+        raw = private.read_text(encoding="utf-8", errors="replace")
+        assert "bind" in raw.lower() or "10048" in raw
+        view, _ = LocalServerLifecycle(
+            home=tmp_path / "home",
+            database=tmp_path / "data/selected.sqlite",
+            host="127.0.0.1",
+            port=port,
+        ).logs(tail=100)
+        assert not any(x["code"] == "READY_FOR_QUERIES" for x in view["events"])
+        public = json.dumps(
+            {
+                "reason": report.get("reason"),
+                "next_action": report.get("next_action"),
+                "events": view["events"],
+            }
+        ).lower()
+        cause_visible = (
+            "address already in use" in public
+            or "port_conflict" in public
+            or "port_in_use" in public
+            or "10048" in public
+            or (
+                "bind" in public
+                and any(x in public for x in ["failed", "unavailable", "conflict"])
+            )
+        )
+        record(
+            "occupied-port",
+            {
+                "cli_exit": code,
+                "state": report["state"],
+                "reason": report.get("reason"),
+                "next_action": report.get("next_action"),
+                "single_spawn": len(children) == 1,
+                "spawn_exit": children[0].returncode,
+                "configured_port_unchanged": True,
+                "configured_database_unchanged": True,
+                "foreign_listener_survived": True,
+                "no_ready_log": True,
+                "actual_bind_failure_observed_in_private_stderr": True,
+                "public_cause_visible": cause_visible,
+                "public_log_codes": [x["code"] for x in view["events"]],
+            },
+        )
+        assert cause_visible, (
+            "Actual bind conflict was hidden by the public service result and bounded service logs"
+        )
