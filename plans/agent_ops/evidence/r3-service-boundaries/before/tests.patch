+def record(name, data):
+    target = Path(os.environ["SVC_EVIDENCE_DIR"]) / (name + ".json")
+    target.write_text(
+        json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8"
+    )
