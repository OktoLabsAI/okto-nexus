+def selection(root, port):
+    approved = root / "empty-discovery"
+    approved.mkdir(exist_ok=True)
+    return [
+        "--home",
+        str(root / "home"),
+        "--db-path",
+        str(root / "data/selected.sqlite"),
+        "--host",
+        "127.0.0.1",
+        "--port",
+        str(port),
+        "--project-root",
+        str(root),
+        "--embedding-mode",
+        "off",
+        "--feature-harness-integrations",
+        "false",
+        "--harness-root",
+        str(approved),
+    ]
+
+
+@contextmanager
+def bound_port():
+    with socket.socket() as listener:
+        if hasattr(socket, "SO_EXCLUSIVEADDRUSE"):
+            listener.setsockopt(socket.SOL_SOCKET, socket.SO_EXCLUSIVEADDRUSE, 1)
+        listener.bind(("127.0.0.1", 0))
+        listener.listen(4)
+        yield listener, listener.getsockname()[1]
+
+
+def free_port():
+    with socket.socket() as listener:
+        listener.bind(("127.0.0.1", 0))
+        return listener.getsockname()[1]
+
+
+def run_serve(root, args):
+    completed = subprocess.run(
+        [
+            sys.executable,
+            "-I",
+            "-X",
+            "utf8",
+            "-m",
+            "okto_nexus.adapters.inbound.cli.main",
+            "serve",
+            *args,
+        ],
+        cwd=root,
+        env=isolated_env(root),
+        stdin=subprocess.DEVNULL,
+        capture_output=True,
+        text=True,
+        encoding="utf-8",
+        timeout=45,
+    )
+    return completed
+
