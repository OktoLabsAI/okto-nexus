+def test_startup_failures_never_bind_or_report_readiness_and_preserve_selection(
+    tmp_path, fault
+):
+    port = free_port()
+    args = selection(tmp_path, port)
+    expected = None
+    before = None
+    db = tmp_path / "data/selected.sqlite"
+    if fault == "invalid_config":
+        args[args.index("--embedding-mode") + 1] = "invalid-mode"
+        expected = "CONFIG_ERROR"
+    elif fault == "future_migration":
+        db.parent.mkdir()
+        with sqlite3.connect(db) as c:
+            c.execute(
+                "CREATE TABLE schema_migrations(version INTEGER PRIMARY KEY, applied_at TEXT NOT NULL)"
+            )
+            c.execute(
+                "INSERT INTO schema_migrations VALUES(999999,'2026-11-07T00:00:00Z')"
+            )
+        with sqlite3.connect(db) as c:
+            before = c.execute("SELECT * FROM schema_migrations").fetchall()
+        expected = "MIGRATION_ERROR"
+    else:
+        db.parent.write_text("not a directory", encoding="utf-8")
+        expected = "Cannot acquire Server instance exclusion"
+    result = run_serve(tmp_path, args)
+    assert result.returncode == 1
+    assert expected in result.stderr
+    assert "initialized successfully" not in result.stderr
+    with socket.socket() as observer:
+        observer.settimeout(0.2)
+        assert observer.connect_ex(("127.0.0.1", port)) != 0
+    assert not (tmp_path / "home/nexus.db").exists()
+    if fault == "invalid_config":
+        assert not (tmp_path / "home").exists() and not db.exists()
+    elif fault == "future_migration":
+        with sqlite3.connect(db) as c:
+            assert c.execute("SELECT * FROM schema_migrations").fetchall() == before
+            assert c.execute(
+                "SELECT name FROM sqlite_master WHERE type='table'"
+            ).fetchall() == [("schema_migrations",)]
+        with ServeLock(tmp_path / "home", db_path=db):
+            pass
+    else:
+        assert db.parent.read_text(encoding="utf-8") == "not a directory"
+        assert not (tmp_path / "home/nexus.serve.lock").exists()
+    # Lifecycle logs live under their own implementation filename; inspect via
+    # canonical API rather than depending on that filename for readiness.
+    view, _ = LocalServerLifecycle(
+        home=tmp_path / "home", database=db, host="127.0.0.1", port=port
+    ).logs(tail=100)
+    assert not any(x["code"] == "READY_FOR_QUERIES" for x in view["events"])
+    record(
+        "startup-" + fault,
+        {
+            "exit": result.returncode,
+            "expected_diagnostic_observed": expected,
+            "listening": False,
+            "ready_log": False,
+            "database_fallback": False,
+            "preserved_future_ledger": fault == "future_migration",
+            "fault_kind": "real isolated state/configuration",
+        },
+    )
