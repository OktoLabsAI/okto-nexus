{
  "$id": "urn:okto:diagnostics:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "component": {
            "const": "connector"
          }
        }
      },
      "then": {
        "properties": {
          "scope": {
            "const": "execution_host"
          },
          "topology": {
            "const": "connector_host"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "component": {
            "const": "nexus"
          }
        }
      },
      "then": {
        "properties": {
          "scope": {
            "enum": [
              "managed_project",
              "participant"
            ],
            "type": "string"
          },
          "topology": {
            "enum": [
              "external_participant",
              "local_server",
              "remote_operator",
              "unconfirmed"
            ],
            "type": "string"
          }
        }
      }
    }
  ],
  "properties": {
    "checks": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "AGENT_DISABLED",
              "AUTHENTICATION_NOT_CHECKED",
              "AUTHENTICATION_UNCONFIRMED",
              "AUTHORIZATION_REQUIRED",
              "AUTH_FAILED",
              "BINARY_CANDIDATE_INVALID",
              "BINARY_CANDIDATE_VALIDATED",
              "BINARY_CHECK_NOT_REQUESTED",
              "BINDING_APPROVED",
              "BINDING_NOT_CHECKED",
              "BINDING_UNAVAILABLE",
              "CHECK_UNCONFIRMED",
              "CLIENT_CONFIGURATION_NOT_CHECKED",
              "CLIENT_CONTEXT_NOT_OBSERVED",
              "CLIENT_ENTRY_PRESENT",
              "CLIENT_RELOAD_NOT_OBSERVED",
              "CONNECTOR_ID_ABSENT",
              "CONNECTOR_ID_PRESENT",
              "CONTAINMENT_PREFLIGHT_CONFIRMED",
              "CONTAINMENT_UNCONFIRMED",
              "COOPERATION_HISTORY_UNCONFIRMED",
              "CORE_CONTRACT_INVALID",
              "CORE_CONTRACT_VERIFIED",
              "CORE_IMPORTED",
              "CORE_IMPORT_FAILED",
              "CREDENTIAL_ENVIRONMENT_ABSENT",
              "CREDENTIAL_REFERENCE_PRESENT",
              "DIAGNOSTIC_LIMIT",
              "DIAGNOSTIC_MUTATION_REFUSED",
              "DOCTOR_ENVIRONMENT_AUTHENTICATED",
              "EXECUTABLE_MISSING",
              "EXECUTION_LOCATION_RESTRICTED",
              "EXTERNAL_PARTICIPANT",
              "FEATURE_DISABLED",
              "HANDOFF_TEST_NOT_OBSERVED",
              "HISTORICAL_EVIDENCE_ONLY",
              "IDENTITY_CREATION_UNCONFIRMED",
              "IDENTITY_METADATA_PRESENT",
              "IDENTITY_NOT_SELECTED",
              "INSTALLATION_CANDIDATES_PRESENT",
              "INSTALLATION_UNCONFIRMED",
              "JOURNAL_NOT_OBSERVED",
              "JOURNAL_SIZE_HIGH",
              "JOURNAL_SIZE_OBSERVED",
              "JOURNAL_UNAVAILABLE",
              "LEGACY_CONTRACT_REPORTED",
              "LOCAL_READINESS_CONFIRMED",
              "MANAGED_PROJECT_PROFILE",
              "MANUAL_CLIENT_CONFIGURATION",
              "MCP_AUTH_REFUSED",
              "MCP_CLIENT_UPGRADE_REQUIRED",
              "MCP_INITIALIZED",
              "MCP_NEGOTIATION_NOT_OBSERVED",
              "MCP_NEGOTIATION_UNCONFIRMED",
              "MCP_ORIGIN_REFUSED",
              "MCP_REQUEST_LIMIT",
              "MCP_RESPONSE_LIMIT",
              "MCP_RESPONSE_UNCONFIRMED",
              "MCP_SURFACE_COMPATIBLE",
              "MCP_SURFACE_INCOMPATIBLE",
              "METHOD_DISABLED",
              "NOT_CHECKED",
              "NOT_FOUND",
              "NOT_OBSERVED",
              "OPEN_BLOCKED",
              "OPEN_ELIGIBLE",
              "OPERATOR_AUTHENTICATED",
              "OPERATOR_LOGIN_REQUIRED",
              "OPERATOR_REQUIRED",
              "OPERATOR_VAULT_UNAVAILABLE",
              "PARTICIPANT_AUTHENTICATED",
              "PARTICIPANT_NOT_AUTHENTICATED",
              "PARTICIPANT_PROFILE_RETIRED",
              "PARTICIPANT_VAULT_UNAVAILABLE",
              "PARTICIPATION_NOT_OBSERVED",
              "PERMISSION_DENIED",
              "PROCESS_CONTAINMENT_UNAVAILABLE",
              "PROFILE_ABSENT",
              "PROFILE_CONFLICT",
              "PROFILE_DRIFT",
              "PROFILE_INVALID",
              "PROFILE_PATH_UNSAFE",
              "PROFILE_READ",
              "PROJECT_IDENTITY_ACTIVE",
              "PROTECTED_CREDENTIAL_READ",
              "PROVIDER_LOGIN_NOT_CHECKED",
              "PYTHON_SUPPORTED",
              "PYTHON_UNSUPPORTED",
              "REMOTE_TOPOLOGY",
              "REMOVAL_RECEIPT_ONLY",
              "RESPONSE_UNCONFIRMED",
              "RUNTIME_DRAINING",
              "RUNTIME_UNCONFIRMED",
              "SCOPE_MISMATCH",
              "SERVER_CHANGED",
              "SERVER_CHECK_NOT_REQUESTED",
              "SERVER_ID_CONFIRMED",
              "SERVER_ID_MISMATCH",
              "SERVER_ID_UNCONFIRMED",
              "SERVER_REDIRECT_REFUSED",
              "SERVER_RESPONSE_CONFIRMED",
              "SERVER_RESPONSE_UNCONFIRMED",
              "SERVER_UNREACHABLE",
              "SERVER_UPGRADE_REQUIRED",
              "SERVICE_IPC_UNCONFIRMED",
              "SERVICE_NOT_READY",
              "SERVICE_READY",
              "SERVICE_UNCONFIRMED",
              "SESSION_CONTROL_AVAILABLE",
              "SESSION_NOT_CHECKED",
              "SESSION_NOT_INTERACTIVE",
              "SETUP_INCOMPLETE",
              "SETUP_NOT_APPLIED",
              "STATE_DIRECTORY_ABSENT",
              "STATE_DIRECTORY_PRESENT",
              "STATE_INVALID",
              "STATE_SCHEMA_COMPATIBLE",
              "STATE_UNAVAILABLE",
              "STATE_VERSION_INCOMPATIBLE",
              "TRANSPORT_NOT_OBSERVED",
              "TRANSPORT_ONLINE",
              "TRANSPORT_UNCONFIRMED",
              "UNSUPPORTED_PLATFORM",
              "VAULT_ACCESS_UNCONFIRMED",
              "VAULT_BACKEND_DISCOVERED",
              "VAULT_ENUMERATION_UNCONFIRMED",
              "VAULT_FALLBACK_APPROVED",
              "VAULT_FALLBACK_NOT_APPROVED",
              "VAULT_NAMESPACE_SNAPSHOT_READ",
              "VAULT_SNAPSHOT_INVALID",
              "WORK_CHECKPOINT_INVALID",
              "WORK_NOT_CHECKED",
              "WORK_NOT_COMPLETED",
              "WORK_RESULT_CONFIRMED"
            ],
            "type": "string"
          },
          "evidence": {
            "additionalProperties": false,
            "properties": {
              "active_version": {
                "maxLength": 64,
                "pattern": "^[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}(?:[+.-][A-Za-z0-9.-]{1,40})?$",
                "type": "string"
              },
              "agent_id": {
                "maxLength": 160,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_.:-]+$",
                "type": "string"
              },
              "agent_session_opened": {
                "type": "boolean"
              },
              "binding_id": {
                "maxLength": 160,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_.:-]+$",
                "type": "string"
              },
              "bytes": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              },
              "compatible_surface": {
                "type": "boolean"
              },
              "context": {
                "enum": [
                  "doctor_process",
                  "participant_doctor"
                ],
                "type": "string"
              },
              "count": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              },
              "installed_version": {
                "maxLength": 64,
                "pattern": "^[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}(?:[+.-][A-Za-z0-9.-]{1,40})?$",
                "type": "string"
              },
              "last_observed_status": {
                "enum": [
                  "FAIL",
                  "NOT_APPLICABLE",
                  "PASS",
                  "UNKNOWN"
                ],
                "type": "string"
              },
              "legacy_binding_count": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              },
              "lifecycle_state": {
                "enum": [
                  "CHECK_UNCONFIRMED",
                  "CLOSED",
                  "FAILED",
                  "OPEN_PENDING",
                  "READY"
                ],
                "type": "string"
              },
              "operation_ids": {
                "items": {
                  "maxLength": 160,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9_.:-]+$",
                  "type": "string"
                },
                "maxItems": 100,
                "type": "array"
              },
              "policy_reasons": {
                "items": {
                  "enum": [
                    "ADAPTER_UNSUPPORTED",
                    "AGENT_DISABLED",
                    "AGENT_RECOVERING",
                    "AUTHORIZATION_REQUIRED",
                    "BINDING_DISABLED",
                    "BINDING_PENDING_REVIEW",
                    "BINDING_REQUIRED",
                    "BINDING_REVOKED",
                    "BINDING_SELECTION_REQUIRED",
                    "BINDING_STALE",
                    "CHECK_UNCONFIRMED",
                    "EXECUTION_LOCATION_RESTRICTED",
                    "EXECUTION_UNAVAILABLE",
                    "EXECUTOR_OFFLINE",
                    "EXECUTOR_RECOVERING",
                    "FEATURE_DISABLED",
                    "INSTALLATION_REQUIRED",
                    "INVENTORY_INCOMPATIBLE",
                    "INVENTORY_STALE",
                    "LOCAL_INTEGRATION_RESTRICTED",
                    "LOCAL_OPERATOR_REQUIRED",
                    "METHOD_DISABLED",
                    "OPERATOR_APPROVAL_REQUIRED",
                    "OPERATOR_REQUIRED",
                    "PREPARATION_REQUIRED",
                    "REALIZATION_SELECTION_REQUIRED",
                    "RUNTIME_DISABLED",
                    "RUNTIME_DRAINING",
                    "TECHNICAL_NOT_READY",
                    "WORKSPACE_REQUIRED"
                  ],
                  "type": "string"
                },
                "maxItems": 32,
                "type": "array"
              },
              "protocol_version": {
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "type": "string"
              },
              "qualification": {
                "enum": [
                  "identities_only"
                ],
                "type": "string"
              },
              "reference": {
                "maxLength": 160,
                "pattern": "^[A-Z_][A-Z0-9_]*$",
                "type": "string"
              },
              "removal_stage": {
                "enum": [
                  "done",
                  "file_pending",
                  "review",
                  "vault_pending"
                ],
                "type": "string"
              },
              "request_ids": {
                "additionalProperties": false,
                "properties": {
                  "handoff_create": {
                    "maxLength": 160,
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9_.:-]+$",
                    "type": "string"
                  },
                  "message_create": {
                    "maxLength": 160,
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9_.:-]+$",
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "required_tools": {
                "items": {
                  "enum": [
                    "handoff_create",
                    "message_create",
                    "session_open"
                  ],
                  "type": "string"
                },
                "maxItems": 3,
                "type": "array"
              },
              "schema_version": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              },
              "server_id": {
                "maxLength": 160,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_.:-]+$",
                "type": "string"
              },
              "session_id": {
                "maxLength": 160,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_.:-]+$",
                "type": "string"
              },
              "setup_run_id": {
                "maxLength": 160,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_.:-]+$",
                "type": "string"
              },
              "smoke_id": {
                "maxLength": 160,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_.:-]+$",
                "type": "string"
              },
              "source": {
                "enum": [
                  "local_receipt"
                ],
                "type": "string"
              },
              "state": {
                "enum": [
                  "approved",
                  "backoff",
                  "blocked",
                  "check_submitted",
                  "completed",
                  "connecting",
                  "credential_pending",
                  "credential_stored",
                  "decision_refused",
                  "degraded",
                  "disconnected",
                  "done",
                  "failed",
                  "file_pending",
                  "finish",
                  "idle",
                  "needs_input",
                  "observing",
                  "offline",
                  "online",
                  "ready",
                  "review",
                  "starting",
                  "stopped",
                  "stopping",
                  "submission_unconfirmed",
                  "test_submitted",
                  "unknown"
                ],
                "type": "string"
              },
              "support": {
                "enum": [
                  "supported",
                  "unsupported"
                ],
                "type": "string"
              },
              "surface_check": {
                "enum": [
                  "names_and_input_fields_v1"
                ],
                "type": "string"
              },
              "technical_reasons": {
                "items": {
                  "enum": [
                    "CHECK_UNCONFIRMED",
                    "build_not_qualified",
                    "containment_unavailable",
                    "containment_unverified",
                    "no_build_observation",
                    "no_installed_candidate",
                    "platform_not_implemented",
                    "selection_required"
                  ],
                  "type": "string"
                },
                "maxItems": 32,
                "type": "array"
              },
              "technical_state": {
                "enum": [
                  "CONTAINMENT_UNAVAILABLE",
                  "NOT_INSTALLED",
                  "NOT_PROBED",
                  "PREPARATION_REQUIRED",
                  "READY_FOR_RUNTIME",
                  "UNQUALIFIED_BUILD",
                  "UNSUPPORTED_PLATFORM"
                ],
                "type": "string"
              },
              "tool_count": {
                "maximum": 512,
                "minimum": 0,
                "type": "integer"
              },
              "tools_called": {
                "const": 0,
                "type": "integer"
              },
              "workspace_id": {
                "maxLength": 160,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_.:-]+$",
                "type": "string"
              }
            },
            "type": "object"
          },
          "id": {
            "enum": [
              "client_configuration",
              "client_reload",
              "connector_identity",
              "coordination_participation",
              "core_contract",
              "core_import",
              "core_legacy_contract",
              "credential_environment",
              "credential_store",
              "daemon_ipc",
              "diagnostic_observation",
              "handoff_test",
              "identity_metadata",
              "installation_inventory",
              "journal_size_observation",
              "local_service",
              "managed_connection",
              "managed_session",
              "mcp_negotiation",
              "mcp_surface",
              "operator_authentication",
              "participant_authentication",
              "participant_profile",
              "project_identity",
              "project_profile",
              "provider_login",
              "python_environment",
              "runtime_binary",
              "runtime_containment",
              "runtime_eligibility",
              "server_identity",
              "server_protocol",
              "server_reachability",
              "state_directory",
              "state_schema",
              "transport",
              "vault_backend",
              "vault_namespaces",
              "work_result"
            ],
            "type": "string"
          },
          "next_action": {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          "reason": {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          "severity": {
            "enum": [
              "error",
              "info",
              "warning"
            ],
            "type": "string"
          },
          "status": {
            "enum": [
              "FAIL",
              "NOT_APPLICABLE",
              "PASS",
              "UNKNOWN"
            ],
            "type": "string"
          },
          "subject": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "maxLength": 160,
                "minLength": 1,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
                "type": "string"
              },
              "kind": {
                "enum": [
                  "binding",
                  "instance",
                  "profile",
                  "server"
                ],
                "type": "string"
              }
            },
            "required": [
              "kind",
              "id"
            ],
            "type": "object"
          }
        },
        "required": [
          "id",
          "subject",
          "status",
          "code",
          "reason",
          "next_action",
          "severity"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "component": {
      "enum": [
        "connector",
        "nexus"
      ],
      "type": "string"
    },
    "counts": {
      "additionalProperties": false,
      "properties": {
        "FAIL": {
          "minimum": 0,
          "type": "integer"
        },
        "NOT_APPLICABLE": {
          "minimum": 0,
          "type": "integer"
        },
        "PASS": {
          "minimum": 0,
          "type": "integer"
        },
        "UNKNOWN": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "PASS",
        "FAIL",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ],
      "type": "object"
    },
    "effects": {
      "additionalProperties": false,
      "properties": {
        "agent_session_opened": {
          "type": "boolean"
        },
        "configuration_applied": {
          "type": "boolean"
        },
        "credential_read": {
          "type": "boolean"
        },
        "grants_issued": {
          "type": "boolean"
        },
        "harness_started": {
          "type": "boolean"
        },
        "mcp_checked": {
          "type": "boolean"
        },
        "service_started": {
          "type": "boolean"
        },
        "tools_called": {
          "type": "boolean"
        },
        "work_submitted": {
          "type": "boolean"
        }
      },
      "required": [
        "service_started",
        "configuration_applied",
        "harness_started",
        "work_submitted",
        "grants_issued"
      ],
      "type": "object"
    },
    "format_version": {
      "const": 1,
      "type": "integer"
    },
    "mode": {
      "enum": [
        "explicit_checks",
        "passive"
      ],
      "type": "string"
    },
    "schema": {
      "const": "okto.diagnostics"
    },
    "scope": {
      "enum": [
        "execution_host",
        "managed_project",
        "participant"
      ],
      "type": "string"
    },
    "state": {
      "enum": [
        "checks_passed",
        "failed_checks",
        "incomplete"
      ],
      "type": "string"
    },
    "topology": {
      "enum": [
        "connector_host",
        "external_participant",
        "local_server",
        "remote_operator",
        "unconfirmed"
      ],
      "type": "string"
    }
  },
  "required": [
    "schema",
    "format_version",
    "component",
    "scope",
    "topology",
    "mode",
    "state",
    "counts",
    "checks",
    "effects"
  ],
  "title": "Okto diagnostics v1 producer contract",
  "type": "object"
}
