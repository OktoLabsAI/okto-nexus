await (async page=>{
 const cfg={"status": "READY_CANONICAL_MULTISESSIONS", "url": "http://127.0.0.1:65508", "reference": {"server_id": "srv_d36e18a89f454bf19e8b780eb2332394", "executor_id": "exe_363b799ff0a665c84c8ea61251186b69", "binding_id": "bind_e02045475dca15828a711749a251c328", "endpoint_id": "ep_80bd2c946fed08a44b85718353ee92a6", "agent_id": "qc31-collaborator", "workspace_id": "wsr_1953da629dddfd5eb9440f1a3c455ffa", "workspace_binding_id": "wxb_47518f504e9481add857d6befeaf0b0b"}, "connect_id": "session-reviewer", "sessions": [{"label": "A", "session_id": "ses_e37c73a90dbaeef7dacbb75974e2bd6e", "text": "QC31 Alpha retained exact output", "closed": true}, {"label": "B", "session_id": "ses_5638fa61dedfc5ebcb9d177d61fc80ad", "text": "QC31 Beta current exact output", "closed": false}], "provider_invocations": 0, "fake_protocol": true, "viewer_events_verified": true, "browser_readonly": true, "browser_deadline_seconds": 180, "at": "2026-11-17T10:07:16.296543+00:00"},checks=[],requests=[],errors=[];
 page.setDefaultTimeout(7000);
 const check=(name,ok,data={})=>{checks.push({name,status:ok?'PASS':'FAIL',...data});if(!ok)throw Error(name);};
 page.on('request',r=>requests.push({method:r.method(),path:new URL(r.url()).pathname}));
 page.on('pageerror',e=>errors.push(e.message));
 const get=async path=>{const r=await page.request.get(cfg.url+path,{headers:{'X-Nexus-UI':'1'}});check('GET '+path.split('?')[0],r.status()===200,{http_status:r.status()});const value=await r.json();return value.data??value;};
 const dismiss=async()=>{const button=page.getByRole('button',{name:'Close metrics settings',exact:true});if(await button.isVisible())await button.click();};
 try{
  await dismiss();
  await page.getByRole('heading',{name:'Harness ID: '+cfg.connect_id,exact:true}).waitFor();
  const binding=await get('/api/v1/runtime-management/connections/bindings/'+cfg.reference.binding_id);
  check('One registered Harness ID retains full canonical connection',Object.entries(cfg.reference).every(([k,v])=>binding[k]===v)&&await page.getByRole('heading',{name:'Harness ID: '+cfg.connect_id,exact:true}).count()===1);
